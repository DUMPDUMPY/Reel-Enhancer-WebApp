# Settings for docker-compose.yml. Copy once and edit the copy:
#   cp .env.example .env
# .env is ignored by git (so `git pull` won't touch it) and is not copied into the image.
# After changing it: sudo docker compose up -d --force-recreate
# Keep comments on their own lines (not after a value). A commented-out line uses the app's default.

# ---------- Speech-to-text ----------
# Cloud (set as many as you have keys for; the web dropdown shows them all):
# ElevenLabs Scribe — with a key it becomes the default model; hint names go out as keyterms
ELEVENLABS_API_KEY=
# Send hint names as keyterms (+20% cost); 0 to disable.
# ELEVENLABS_KEYTERMS=1
# Google Gemini 3.5 Transcribe — same AI Studio key as proofreading (GEMINI_API_KEY).
# Free tier 10 requests/day per model, 3 requests/minute. Hint words CANNOT bias it:
# word timestamps may not be combined with a custom vocabulary.
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# Language hints (BCP-47); empty = auto-detect.
# GEMINI_STT_LANGUAGES=th-TH
# Google Cloud Speech-to-Text v2 (Chirp) — needs a Cloud key (AIzaSy…) created in the GCP
# console with the Cloud Speech-to-Text API enabled; an AI Studio key (AQ.…) answers 401.
# Free tier 60 minutes/month.
# GOOGLE_CLOUD_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# Region serving the model (us / eu / asia-south1 ...).
# GOOGLE_CLOUD_LOCATION=us
# GOOGLE_CLOUD_STT_MODELS=chirp_3
# Default model, e.g. elevenlabs:scribe_v2, gemini:gemini-3.5-transcribe, google:chirp_3,
# or a Whisper ggml-*.bin name. Empty = the first cloud model with a key
# (order: ElevenLabs → Gemini → Google), else Whisper on the iGPU.
TRANSCRIBE_MODEL=
# Whisper on the NAS (used by both containers).
WHISPER_MODEL=ggml-large-v3-q5_0.bin
# Send hint names as keyterms (+20% cost); 0 to disable.
# ELEVENLABS_KEYTERMS=1

# ---------- AI proofreading ----------
# A key enables that provider; the NAS then doesn't run any LLM itself.
# Z.AI GLM Coding Plan key (glm-5.3, glm-5.3-flash).
ZAI_API_KEY=
# Only for a pay-as-you-go key (default is the Coding Plan endpoint):
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# GLM 5.3 always thinks: low | high | max (max uses the most tokens).
# ZAI_REASONING_EFFORT=high
# opentyphoon.ai (Thai): typhoon-v2.5-30b-a3b-instruct
TYPHOON_API_KEY=
# OpenRouter needs a model list too, e.g. google/gemini-2.5-flash,qwen/qwen3-235b-a22b
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
GEMINI_API_KEY=
# Any other OpenAI-compatible API:
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODELS=
# Default model, e.g. zai:glm-5.3. Empty = first cloud provider with a key, else Ollama.
PROOFREAD_MODEL=
# Cues per proofreading request.
# PROOFREAD_BATCH=10

# ---------- Ollama (separate DSM project, port 11434) ----------
# Use the NAS IP (e.g. http://192.168.1.4:11434) if host.docker.internal doesn't work.
# Empty = hide Ollama.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
# Seconds per batch; also used for cloud APIs.
OLLAMA_TIMEOUT=300

# ---------- Rendering / housekeeping ----------
# auto | vaapi | cpu
RENDER_MODE=auto
# Only used if rendering falls back to the CPU.
CPU_THREADS=4
JOB_RETENTION_HOURS=72
